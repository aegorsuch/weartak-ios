          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להגדיר את המיקום ל״תמיד״ (עם מיקום מדויק מופעל) כדי שהשעון יישאר מחובר ל-TAK כשהטלפון נעול או בכיס."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Állítsa a helyhozzáférést „Mindig” értékre (bekapcsolt Pontos helyzettel), hogy az óra zárolt vagy zsebben lévő telefon mellett is csatlakozzon a TAK-hoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atur lokasi ke “Selalu” (dengan Lokasi Akurat aktif) agar Watch tetap tersambung ke TAK saat ponsel terkunci atau berada di saku."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "휴대폰이 잠겨 있거나 주머니에 있는 동안 Watch가 TAK에 연결된 상태를 유지하도록 위치를 ‘항상’으로 설정하고 정확한 위치를 켜세요."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Iestatiet atrašanās vietu uz „Vienmēr” (ieslēdzot precīzo atrašanās vietu), lai pulkstenis paliktu savienots ar TAK, kad tālrunis ir bloķēts vai kabatā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nustatykite vietą į „Visada“ (įjungę tikslią vietą), kad laikrodis liktų prijungtas prie TAK, kai telefonas užrakintas arba kišenėje."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sett posisjon til «Alltid» (med nøyaktig posisjon på) slik at klokken forblir tilkoblet TAK når telefonen er låst eller i lommen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ustaw lokalizację na „Zawsze” (z włączoną Dokładną lokalizacją), aby zegarek pozostał połączony z TAK, gdy telefon jest zablokowany lub w kieszeni."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setați localizarea la „Întotdeauna” (cu Localizarea precisă activată), pentru ca ceasul să rămână conectat la TAK când telefonul este blocat sau în buzunar."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nastavte polohu na „Vždy“ (so zapnutou presnou polohou), aby hodinky zostali pripojené k TAK, keď je telefón zamknutý alebo vo vrecku."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lokacijo nastavite na »Vedno« (z vklopljeno natančno lokacijo), da ura ostane povezana s TAK, ko je telefon zaklenjen ali v žepu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ställ in platsåtkomst på ”Alltid” (med exakt plats aktiverad) så att klockan förblir ansluten till TAK när telefonen är låst eller i fickan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตั้งค่าตำแหน่งที่ตั้งเป็น “ตลอดเวลา” (และเปิดตำแหน่งที่ตั้งที่แม่นยำ) เพื่อให้นาฬิกาเชื่อมต่อกับ TAK เมื่อโทรศัพท์ล็อกหรืออยู่ในกระเป๋า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefon kilitliyken veya cebinizdeyken saatin TAK bağlantısını koruması için konumu “Her Zaman” olarak ayarlayın (Kesin Konum açık olmalı)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Установіть для геолокації значення «Завжди» (увімкнувши точну геолокацію), щоб годинник залишався підключеним до TAK, коли телефон заблоковано або в кишені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đặt quyền vị trí thành “Luôn luôn” (bật Vị trí chính xác) để đồng hồ vẫn kết nối TAK khi điện thoại bị khóa hoặc ở trong túi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tetapkan lokasi kepada “Sentiasa” (dengan Lokasi Tepat dihidupkan) supaya Watch kekal bersambung ke TAK apabila telefon dikunci atau di dalam poket."
          }
        }
      }
    },
