    "Turn on Location Services so the watch stays connected to TAK while this phone is locked.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "فعّل خدمات الموقع ليبقى اتصال الساعة بـ TAK قائمًا عند قفل هذا الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiviere die Ortungsdienste, damit die Watch bei gesperrtem Telefon mit TAK verbunden bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Location Services so the watch stays connected to TAK while this phone is locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa los servicios de localización para que el reloj siga conectado a TAK cuando el teléfono esté bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez les services de localisation pour que la montre reste connectée à TAK lorsque ce téléphone est verrouillé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attiva i servizi di localizzazione affinché l’orologio resti connesso a TAK quando questo telefono è bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この電話がロック中もウォッチをTAKに接続したままにするには、位置情報サービスをオンにしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative os Serviços de Localização para manter o relógio conectado ao TAK quando este telefone estiver bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включите службы геолокации, чтобы часы оставались подключены к TAK, когда телефон заблокирован."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请开启定位服务，以便此手机锁定时手表仍保持与 TAK 的连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請開啟定位服務，讓此手機鎖定時手錶仍保持連線至 TAK。"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включете услугите за местоположение, за да остане часовникът свързан с TAK, докато телефонът е заключен."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uključite usluge lokacije kako bi sat ostao povezan s TAK-om dok je telefon zaključan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapněte polohové služby, aby hodinky zůstaly připojené k TAK, i když je telefon zamčený."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå lokalitetstjenester til, så uret forbliver forbundet til TAK, når telefonen er låst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel Locatievoorzieningen in zodat de Watch verbonden blijft met TAK wanneer deze telefoon is vergrendeld."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lülita asukohateenused sisse, et kell püsiks TAK-iga ühenduses, kui telefon on lukus."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ota sijaintipalvelut käyttöön, jotta kello pysyy yhteydessä TAK-palveluun puhelimen ollessa lukittuna."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ενεργοποιήστε τις υπηρεσίες τοποθεσίας για να παραμένει το ρολόι συνδεδεμένο στο TAK όταν το τηλέφωνο είναι κλειδωμένο."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש להפעיל שירותי מיקום כדי שהשעון יישאר מחובר ל-TAK כשהטלפון נעול."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kapcsolja be a Helymeghatározást, hogy az óra a telefon zárolásakor is csatlakozva maradjon a TAK-hoz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktifkan Layanan Lokasi agar Watch tetap tersambung ke TAK saat ponsel terkunci."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "휴대폰이 잠겨 있는 동안 Watch가 TAK에 연결된 상태를 유지하도록 위치 서비스를 켜세요."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ieslēdziet atrašanās vietas pakalpojumus, lai pulkstenis paliktu savienots ar TAK, kad tālrunis ir bloķēts."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Įjunkite vietos nustatymo paslaugas, kad užrakintas telefonas nenutrauktų laikrodžio ryšio su TAK."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå på stedstjenester slik at klokken forblir tilkoblet TAK når telefonen er låst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włącz usługi lokalizacji, aby zegarek pozostał połączony z TAK, gdy telefon jest zablokowany."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activați Serviciile de localizare pentru ca ceasul să rămână conectat la TAK când telefonul este blocat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zapnite lokalizačné služby, aby hodinky zostali pripojené k TAK, keď je telefón zamknutý."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vklopite lokacijske storitve, da ura ostane povezana s TAK, ko je telefon zaklenjen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktivera platstjänster så att klockan förblir ansluten till TAK när telefonen är låst."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดบริการหาตำแหน่งเพื่อให้นาฬิกาเชื่อมต่อกับ TAK ไว้ขณะที่โทรศัพท์ล็อกอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Telefon kilitliyken saatin TAK bağlantısını sürdürmesi için Konum Servisleri'ni açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкніть служби геолокації, щоб годинник залишався підключеним до TAK, коли телефон заблоковано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bật Dịch vụ định vị để đồng hồ duy trì kết nối TAK khi điện thoại bị khóa."
          }
        },
        "ms": {
          "stringUnit": {
