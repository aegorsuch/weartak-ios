    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يقرأ WearTAK معدل ضربات القلب لعرض بياناتك الفسيولوجية وتقييم التنبيهات التي وافقت على تفعيلها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK чете пулса, за да показва физиологични данни и да оценява избраните от вас сигнали."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK čita broj otkucaja srca radi prikaza fizioloških podataka i procjene upozorenja koja ste uključili."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK čte tepovou frekvenci, aby zobrazil fyziologické údaje a vyhodnocoval upozornění, která jste povolili."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK læser din puls for at vise fysiologiske data og vurdere de alarmer, du har tilvalgt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK leest je hartslag om fysiologische gegevens weer te geven en waarschuwingen waarvoor je hebt gekozen te beoordelen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WearTAK reads heart rate to show physiology and evaluate opted-in alerts."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK loeb pulssi, et kuvada füsioloogilisi andmeid ja hinnata sinu lubatud hoiatusi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK lukee sykkeesi näyttääkseen fysiologisia tietoja ja arvioidakseen käyttöön ottamiasi hälytyksiä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK lit votre fréquence cardiaque pour afficher vos données physiologiques et évaluer les alertes que vous avez activées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK liest deine Herzfrequenz aus, um physiologische Daten anzuzeigen und von dir aktivierte Warnungen auszuwerten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το WearTAK διαβάζει τους καρδιακούς παλμούς για να εμφανίζει φυσιολογικά δεδομένα και να αξιολογεί τις ειδοποιήσεις που έχετε επιλέξει."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK קוראת את קצב הלב כדי להציג נתונים פיזיולוגיים ולהעריך התראות שהפעלת."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A WearTAK kiolvassa a pulzust, hogy élettani adatokat jelenítsen meg és kiértékelje az engedélyezett riasztásokat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK membaca detak jantung untuk menampilkan data fisiologis dan mengevaluasi peringatan yang Anda aktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK legge la frequenza cardiaca per mostrare i dati fisiologici e valutare gli avvisi che hai attivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAKは心拍数を読み取り、生理データを表示し、オプトインしたアラートを評価します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK은 심박수를 읽어 생리 데이터를 표시하고 사용자가 동의한 알림을 평가합니다."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK nolasa sirdsdarbības ātrumu, lai rādītu fizioloģiskos datus un izvērtētu jūsu ieslēgtos brīdinājumus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK nuskaito širdies ritmą, kad rodytų fiziologinius duomenis ir įvertintų jūsų įjungtus įspėjimus."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK leser pulsen for å vise fysiologiske data og vurdere varslene du har valgt å motta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK odczytuje tętno, aby wyświetlać dane fizjologiczne i oceniać włączone alerty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O WearTAK lê a frequência cardíaca para apresentar dados fisiológicos e avaliar os alertas ativados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK citește ritmul cardiac pentru a afișa date fiziologice și a evalua alertele activate de dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK считывает частоту сердечного ритма, чтобы показывать физиологические данные и оценивать включённые вами оповещения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK číta srdcovú frekvenciu, aby zobrazoval fyziologické údaje a vyhodnocoval upozornenia, ktoré ste povolili."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK bere srčni utrip za prikaz fizioloških podatkov in ocenjevanje vklopljenih opozoril."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK lee la frecuencia cardiaca para mostrar datos fisiológicos y evaluar las alertas que hayas activado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK läser av pulsen för att visa fysiologiska data och utvärdera de aviseringar du har valt att aktivera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK อ่านอัตราการเต้นของหัวใจเพื่อแสดงข้อมูลทางสรีรวิทยาและประเมินการแจ้งเตือนที่คุณเลือกเปิดใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK, fizyolojik verileri göstermek ve etkinleştirdiğiniz uyarıları değerlendirmek için kalp atış hızınızı okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK зчитує частоту серцевих скорочень, щоб показувати фізіологічні дані й оцінювати ввімкнені вами сповіщення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK đọc nhịp tim để hiển thị dữ liệu sinh lý và đánh giá các cảnh báo bạn đã bật."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK membaca kadar denyutan jantung untuk memaparkan data fisiologi dan menilai amaran yang anda aktifkan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK 会读取心率以显示生理数据，并评估你选择启用的提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK 會讀取心率以顯示生理資料，並評估您選擇啟用的提示。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستخدم WearTAK إطار HealthKit لمراقبة معدل ضربات القلب والتنبيهات الفسيولوجية التي تفعّلها. لا يحفظ هذا الإصدار بياناتك الصحية ولا يعدّلها."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK използва HealthKit за следене на пулса и физиологичните сигнали, които включите. Тази версия не записва и не променя здравните ви данни."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK upotrebljava HealthKit za praćenje otkucaja srca i fiziološka upozorenja koja uključite. Ova verzija ne sprema niti mijenja vaše zdravstvene podatke."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK používá HealthKit ke sledování tepové frekvence a fyziologických upozornění, která zapnete. Tato verze vaše zdravotní údaje neukládá ani nemění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK bruger HealthKit til pulsmåling og de fysiologiske alarmer, du aktiverer. Denne version gemmer eller ændrer ikke dine sundhedsdata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK gebruikt HealthKit voor hartslagmeting en de fysiologische waarschuwingen die je inschakelt. Deze versie slaat je gezondheidsgegevens niet op en wijzigt ze niet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WearTAK uses HealthKit for heart-rate monitoring and physiological alerts you enable. This version does not save or modify your Health data."
          }
        },
        "et": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK kasutab HealthKiti pulsi jälgimiseks ja sinu lubatud füsioloogiliste hoiatuste jaoks. See versioon ei salvesta ega muuda sinu terviseandmeid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK käyttää HealthKitiä sykkeen seurantaan ja käyttöön ottamiisi fysiologisiin hälytyksiin. Tämä versio ei tallenna eikä muuta terveystietojasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK utilise HealthKit pour surveiller votre fréquence cardiaque et gérer les alertes physiologiques que vous activez. Cette version n’enregistre ni ne modifie vos données de santé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK verwendet HealthKit zur Überwachung der Herzfrequenz und für die von dir aktivierten physiologischen Warnungen. Diese Version speichert oder verändert deine Gesundheitsdaten nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το WearTAK χρησιμοποιεί το HealthKit για την παρακολούθηση καρδιακών παλμών και τις φυσιολογικές ειδοποιήσεις που ενεργοποιείτε. Αυτή η έκδοση δεν αποθηκεύει ούτε τροποποιεί τα δεδομένα υγείας σας."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK משתמשת ב‑HealthKit לניטור קצב הלב ולהתראות הפיזיולוגיות שתפעיל. גרסה זו אינה שומרת או משנה את נתוני הבריאות שלך."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A WearTAK a HealthKitet használja a pulzus figyelésére és az általad bekapcsolt élettani riasztásokhoz. Ez a verzió nem menti és nem módosítja az egészségügyi adataidat."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK menggunakan HealthKit untuk memantau detak jantung dan peringatan fisiologis yang Anda aktifkan. Versi ini tidak menyimpan atau mengubah data Kesehatan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK usa HealthKit per monitorare la frequenza cardiaca e gestire gli avvisi fisiologici che attivi. Questa versione non salva né modifica i tuoi dati Salute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAKはHealthKitを心拍数のモニタリングと有効にした生理アラートに使用します。このバージョンはヘルスケアデータを保存または変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK은 심박수 모니터링과 사용자가 켠 생리 알림에 HealthKit을 사용합니다. 이 버전은 건강 데이터를 저장하거나 수정하지 않습니다."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK izmanto HealthKit sirdsdarbības uzraudzībai un jūsu ieslēgtajiem fizioloģiskajiem brīdinājumiem. Šī versija nesaglabā un nemaina jūsu veselības datus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK naudoja „HealthKit“ širdies ritmui stebėti ir jūsų įjungtiems fiziologiniams įspėjimams. Ši versija neišsaugo ir nekeičia jūsų sveikatos duomenų."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK bruker HealthKit til pulsmåling og fysiologiske varsler du aktiverer. Denne versjonen lagrer eller endrer ikke helsedataene dine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK używa HealthKit do monitorowania tętna i obsługi włączonych alertów fizjologicznych. Ta wersja nie zapisuje ani nie modyfikuje danych zdrowotnych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O WearTAK usa o HealthKit para monitorizar a frequência cardíaca e os alertas fisiológicos que ativar. Esta versão não guarda nem modifica os seus dados de Saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK folosește HealthKit pentru monitorizarea ritmului cardiac și alertele fiziologice pe care le activați. Această versiune nu salvează și nu modifică datele dvs. de sănătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK использует HealthKit для отслеживания частоты сердечного ритма и включённых вами физиологических оповещений. Эта версия не сохраняет и не изменяет данные приложения «Здоровье»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK používa HealthKit na monitorovanie srdcovej frekvencie a fyziologické upozornenia, ktoré zapnete. Táto verzia vaše zdravotné údaje neukladá ani nemení."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK uporablja HealthKit za spremljanje srčnega utripa in fiziološka opozorila, ki jih vklopite. Ta različica vaših zdravstvenih podatkov ne shranjuje ali spreminja."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK usa HealthKit para monitorizar la frecuencia cardiaca y las alertas fisiológicas que actives. Esta versión no guarda ni modifica tus datos de Salud."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WearTAK använder HealthKit för pulsmätning och de fysiologiska aviseringar du aktiverar. Den här versionen sparar eller ändrar inte dina hälsodata."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
